#!/bin/bash
set -e

echo "🔍 Checking staged files..."

# Get the list of staged files (excluding shell scripts, config files, etc.)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|jsonc)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No source files to format"
  exit 0
fi

echo "📝 Formatting $(echo "$STAGED_FILES" | wc -l) file(s)..."

# Format only the staged files
if ! npx ultracite format $STAGED_FILES; then
  echo "⚠️  Formatting failed, but continuing..."
fi

echo "🔄 Re-staging files..."

# Re-stage the files
git diff --cached --name-only --diff-filter=ACM | xargs -r git add

echo "✅ Pre-commit checks passed!"
