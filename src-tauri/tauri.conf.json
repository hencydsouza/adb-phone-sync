{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "adb-phone-sync",
  "version": "0.1.0",
  "identifier": "com.hency.adb-phone-sync",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "adb-phone-sync",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/adb", "binaries/adbsync"],
    "resources": {
      "binaries/AdbWinApi.dll": "AdbWinApi.dll",
      "binaries/AdbWinUsbApi.dll": "AdbWinUsbApi.dll"
    }
  }
}
